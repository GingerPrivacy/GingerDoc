---
import LanguageSelect from '@astrojs/starlight/components/LanguageSelect.astro'

const { lang } = Astro.locals.starlightRoute
const code = lang.toUpperCase().replace(/^ZH-.*/, 'ZH')
---

<div class="ginger-language-menu" style={`--language-width: ${code.length > 2 ? '5.75rem' : '3.75rem'}`}>
  <span class="separator" aria-hidden="true">/</span>
  <div class="picker">
    <span class="current-language" aria-hidden="true">{code}</span>
    <LanguageSelect />
  </div>
</div>

<style>
  .ginger-language-menu { display: flex; align-items: center; flex-shrink: 0; gap: .75rem; margin-inline-start: .75rem; }
  .separator { color: var(--sl-color-gray-2); font-size: 1.25rem; }
  .picker { position: relative; }
  .current-language { position: absolute; inset-inline-start: .25rem; top: 50%; transform: translateY(-50%); color: var(--sl-color-text); font-size: .875rem; font-weight: 600; pointer-events: none; }
  .picker:focus-within .current-language, .picker:hover .current-language { color: var(--sl-color-text-accent); }
  .picker :global(select) { width: var(--language-width); min-height: 2.75rem; margin: 0; padding-inline: .25rem 1.25rem; color: transparent; font-size: .875rem; }
  .picker :global(option) { color: var(--sl-color-text); background: var(--sl-color-bg-nav); }
  .picker :global(.label-icon) { display: none; }
  .picker :global(.caret) { color: var(--sl-color-text); }
  .picker :global(select:focus-visible) { outline: 2px solid var(--sl-color-text-accent); outline-offset: 2px; border-radius: .25rem; }
  @media (max-width: 30rem) { .ginger-language-menu { gap: .5rem; margin-inline-start: .5rem; } }
</style>
