---
/**
 * Adds top-level section links to the header, next to the logo — the
 * equivalent of the old VuePress `navbar` config.
 *
 * This wraps Starlight's own SiteTitle rather than replacing it, so the logo
 * keeps whatever behaviour the theme gives it across upgrades.
 *
 * Leave room for search and community links on smaller screens. The sidebar
 * and the homepage's first steps provide navigation when these links are hidden.
 */
import Default from '@astrojs/starlight/components/SiteTitle.astro'
import LanguageMenu from './LanguageMenu.astro'
import { copyForLanguage } from '../localization'

const base = import.meta.env.BASE_URL.replace(/\/$/, '')
const { locale, lang } = Astro.locals.starlightRoute
const copy = copyForLanguage(lang)
const withBase = (path: string) => base + (locale ? '/' + locale : '') + path

const links = [
  { label: copy.header['Getting Started'], href: withBase('/getting-started/') },
  { label: copy.header['Why Ginger?'], href: withBase('/why-ginger/') },
  { label: copy.header['Using Ginger'], href: withBase('/using-ginger/') },
]

// `/using-ginger/fee/` should light up the `/using-ginger/` link.
const current = Astro.url.pathname
const isActive = (href: string) => current === href || current.startsWith(href)
---

<Default {...Astro.props}><slot /></Default>
<LanguageMenu />

<nav class="header-nav" aria-label={Astro.locals.t('sidebarNav.accessibleLabel')}>
  {
    links.map(({ label, href }) => (
      <a href={href} aria-current={isActive(href) ? 'page' : undefined}>
        {label}
      </a>
    ))
  }
</nav>

<style>
	.header-nav {
		display: none;
	}

	@media (min-width: 90rem) {
		.header-nav {
			display: flex;
			align-items: center;
			gap: 1.75rem;
			margin-inline-start: 2.25rem;
			white-space: nowrap;
		}
	}

	.header-nav a {
		font-size: 1rem;
		font-weight: 500;
		color: var(--sl-color-text);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 2px solid transparent;
	}

	.header-nav a:hover,
	.header-nav a:focus-visible {
		color: var(--sl-color-text-accent);
	}

	.header-nav a[aria-current='page'] {
		color: var(--sl-color-text-accent);
		border-bottom-color: var(--sl-color-text-accent);
	}
</style>
