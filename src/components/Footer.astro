---
import Default from '@astrojs/starlight/components/Footer.astro'
import config from 'virtual:starlight/user-config'

const { head, lang, id } = Astro.locals.starlightRoute
const links = head.filter(({ tag, attrs }) => tag === 'link' && attrs?.rel === 'alternate' && attrs.hreflang !== 'x-default')
  .flatMap(({ attrs }) => {
    if (typeof attrs?.href !== 'string' || typeof attrs.hreflang !== 'string') return []
    const [code, locale] = Object.entries(config.locales ?? {}).find(([, locale]) => locale?.lang === attrs.hreflang) ?? []
    if (!locale) return []
    return [{ code, label: locale.label, lang: attrs.hreflang, href: new URL(attrs.href).pathname }]
  })
---

<Default />
{id !== '404' && <details class="ginger-language-links" data-pagefind-ignore>
  <summary>{Astro.locals.t('languageSelect.accessibleLabel')}</summary>
  <nav aria-label={Astro.locals.t('languageSelect.accessibleLabel')}>
    <ul>
      {links.map((link) => <li><a href={link.href} lang={link.lang} hreflang={link.lang}
        data-ginger-locale={link.code} aria-current={link.lang === lang ? 'page' : undefined}>{link.label}</a></li>)}
    </ul>
  </nav>
</details>}

<style>
  .ginger-language-links { margin-top: 1.5rem; font-size: var(--sl-text-sm); }
  summary { cursor: pointer; color: var(--sl-color-text); }
  ul { display: flex; flex-wrap: wrap; gap: .5rem 1.25rem; list-style: none; padding: 0; margin: .75rem 0 0; }
  a { display: inline-block; padding-block: .5rem; color: var(--sl-color-text-accent); }
  a[aria-current='page'] { font-weight: 600; }
</style>

<script>
  document.addEventListener('click', (event) => {
    const target = event.target
    if (!(target instanceof Element)) return
    const link = target.closest<HTMLAnchorElement>('a[data-ginger-locale]')
    if (!link?.dataset.gingerLocale) return
    try { localStorage.setItem('ginger-docs-language', link.dataset.gingerLocale) } catch {}
  }, { capture: true })
</script>
